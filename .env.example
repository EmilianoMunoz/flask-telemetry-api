FLASK_CONTEXT=development
PORT=5000
LOG_LEVEL=INFO
SERVICE_NAME=flask-telemetry-api
SERVICE_NAMESPACE=portfolio

# Base PostgreSQL local usada por Docker Compose.
POSTGRES_DB=telemetry
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=change-me-for-local-development

# Conexión consumida por la API.
AZURE_POSTGRESQL_HOST=postgres
AZURE_POSTGRESQL_DB=telemetry
AZURE_POSTGRESQL_USER=telemetry
AZURE_POSTGRESQL_PASSWORD=change-me-for-local-development
AZURE_POSTGRESQL_PORT=5432

# Opcional. Si está vacía, la API funciona sin exportar trazas.
APPLICATIONINSIGHTS_CONNECTION_STRING=
